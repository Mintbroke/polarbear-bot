# Required for main.py
DISCORD_TOKEN=your_discord_bot_token_here

# Required: Postgres database for birthday storage.
# Preferred name is DB_URL. DATABASE_URL is also accepted by main.py.
DB_URL=postgresql://user:password@host:5432/database
# DATABASE_URL=postgresql://user:password@host:5432/database

# Birthday announcement defaults.
BIRTHDAY_TIMEZONE=America/Los_Angeles
BIRTHDAY_ANNOUNCE_HOUR=9

# Optional: extra Discord user ID allowed to manage birthday settings.
# Server owners and users with Manage Server can already manage birthday settings.
BIRTHDAY_ADMIN_ID=0

# Optional: user ID that triggers the auto-glaze response.
GOAT_ID=0

# Optional: Google Translate feature.
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
# GOOGLE_CLOUD_TRANSLATE_API_KEY=your_google_translate_api_key_here
# GOOGLE_TRANSLATE_MODEL=nmt

# Optional: attach debug WAV files for transcription.
TRANSCRIBE_DEBUG=false

# Optional: only used if keep_alive() / web.py is enabled.
PORT=8080

# Legacy entrypoint only: polarbear_discord.py uses this instead of DISCORD_TOKEN.
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
